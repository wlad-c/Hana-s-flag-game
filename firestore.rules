rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id', 'playerName', 'score', 'createdAt', 'correctCount', 'wrongCount', 'totalAnswered', 'totalFlags', 'elapsedMs'])
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() >= 1
        && request.resource.data.playerName.size() <= 48
        && request.resource.data.score is number
        && request.resource.data.score >= 0;
      allow update, delete: if false;
    }

    // User profiles (shared personas). PUBLIC by design: profiles have no
    // password or share code — anyone on any device may list, read, pick,
    // edit, or delete any profile. `request.auth != null` only blocks fully
    // unauthenticated traffic (every client authes anonymously); it does not
    // scope access to a specific user. This is the accepted trade-off of a
    // passwordless, kiosk-style model.
    match /profiles/{profileId} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 48
        && request.resource.data.avatarId is string
        && request.resource.data.avatarId.size() <= 400000
        && request.resource.data.selectedCodes is list
        && request.resource.data.learnedCodes is list;
    }

    // Flag Bingo multiplayer rooms. Authenticated (anonymous) clients may
    // create/join rooms and advance shared draws. Boards live on each
    // player doc; drawnCodes on the room is append-only during play.
    // This is a casual party game — rules validate shape, not full
    // anti-cheat (no Cloud Functions in this project).
    match /bingoRooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'code', 'status', 'hostId', 'playerIds', 'poolCodes', 'drawnCodes',
          'winnerId', 'winnerName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.code is string
        && request.resource.data.code == roomId
        && request.resource.data.status == 'lobby'
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.playerIds is list
        && request.resource.data.playerIds.size() == 1
        && request.resource.data.playerIds[0] == request.auth.uid
        && request.resource.data.poolCodes is list
        && request.resource.data.poolCodes.size() == 0
        && request.resource.data.drawnCodes is list
        && request.resource.data.drawnCodes.size() == 0;
      allow update: if request.auth != null
        && request.resource.data.code == resource.data.code
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.hostId is string
        && request.resource.data.playerIds is list
        && request.resource.data.playerIds.size() <= 32
        && request.resource.data.drawnCodes is list
        // poolCodes is required on create; older rooms may lack it until the
        // next Start / draw write adds the match's 64-flag pool.
        && (
          !('poolCodes' in request.resource.data)
          || (
            request.resource.data.poolCodes is list
            && request.resource.data.poolCodes.size() <= 64
          )
        )
        // Draws only append while playing; resetting to lobby may clear them.
        && (
          request.resource.data.drawnCodes.size() >= resource.data.drawnCodes.size()
          || request.resource.data.status == 'lobby'
        )
        && request.resource.data.status in ['lobby', 'playing', 'finished'];
      allow delete: if false;

      match /players/{playerId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == playerId
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 48
          && request.resource.data.avatarId is string
          && request.resource.data.board is list
          && request.resource.data.marked is list
          && request.resource.data.ready is bool;
        // Own seat, or any authenticated client updating boards/ready/marks
        // during host start / shared draw advance / manual cell confirm.
        allow update: if request.auth != null
          && request.resource.data.id == playerId
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 48
          && request.resource.data.board is list
          && request.resource.data.board.size() <= 25
          && request.resource.data.marked is list
          && request.resource.data.marked.size() <= 25
          && request.resource.data.ready is bool;
        allow delete: if request.auth != null
          && request.auth.uid == playerId;
      }
    }
  }
}
